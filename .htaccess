# CIPorti a teatro? - impostazioni per Hostinger (Apache / LiteSpeed)

# Sempre in HTTPS e senza "www"
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ciportiateatro.it%{REQUEST_URI} [L,R=301]

# Niente elenco dei file nelle cartelle
Options -Indexes

# Tipi di file
AddType font/ttf .ttf
AddType image/svg+xml .svg

# Compressione
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml font/ttf application/xml text/plain
</IfModule>

# Cache: pagina sempre aggiornata, file statici per un mese
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>
